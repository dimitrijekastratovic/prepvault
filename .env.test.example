# =============================================================================
# .env.test — environment variables consumed by the pytest test runner.
# Auto-loaded by pytest-dotenv (configured in pyproject.toml under
# [tool.pytest.ini_options]).
#
# Copy this file to `.env.test` and fill in real values. `.env.test` is
# gitignored; this example is the documented contract.
# =============================================================================

# -----------------------------------------------------------------------------
# Connection string the test suite uses. Points at the dedicated test database
# created by docker/app-db-init/01-create-test-db.sql when the app-db container
# first boots. Host is `localhost` because pytest runs on the host machine
# against the Postgres container's published port (5432).
# - user/password MUST match POSTGRES_USER/POSTGRES_PASSWORD in app-db.env.
# - database name MUST be `prepvault_test` (the name created by the init SQL).
# -----------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/prepvault_test
DATABASE_DEBUG=true

