# EditorConfig — https://editorconfig.org
#
# Enforces consistent indentation, line endings, and trailing whitespace
# rules across editors and IDEs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python uses 4-space indentation
[*.py]
indent_size = 4

# Makefiles require tabs
[Makefile]
indent_style = tab

# Markdown — preserve trailing whitespace (used for line breaks)
[*.md]
trim_trailing_whitespace = false
