# =============================================================================
# judge0-db.env — bootstrap credentials for Judge0's internal Postgres.
# Loaded into the `judge0-db` container via `env_file: judge0-db.env` in
# docker-compose.yml. This database is for Judge0's internal use only
# (submissions queue, languages catalog) — the application never connects to
# it. See ADR-0003 for why Judge0 has its own database.
#
# IMPORTANT: these values are only honored on first boot when the data volume
# is empty. Changing them later does NOT update the existing role/database.
# =============================================================================

# -----------------------------------------------------------------------------
# Username Postgres creates and grants ownership of POSTGRES_DB.
# - MUST match POSTGRES_USER in judge0.env (Judge0 reads that value to connect).
# -----------------------------------------------------------------------------
POSTGRES_USER=username

# -----------------------------------------------------------------------------
# Password for POSTGRES_USER.
# - MUST match POSTGRES_PASSWORD in judge0.env.
# - Generate with: openssl rand -hex 16
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=password

# -----------------------------------------------------------------------------
# Database created on first boot, owned by POSTGRES_USER.
# - MUST match POSTGRES_DB in judge0.env.
# -----------------------------------------------------------------------------
POSTGRES_DB=db_name
