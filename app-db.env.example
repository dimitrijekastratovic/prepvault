# =============================================================================
# app-db.env — bootstrap credentials for the application's Postgres container.
# Loaded into the `app-db` container via `env_file: app-db.env` in
# docker-compose.yml. Read by the official `postgres:16` image's entrypoint
# script on FIRST boot to create the user, password, and database.
#
# IMPORTANT: these values are only honored on first boot when the data volume
# is empty. Changing them later does NOT update the existing role/database —
# you must either ALTER it manually or `docker compose down -v` to recreate.
# =============================================================================

# -----------------------------------------------------------------------------
# Username Postgres creates and grants ownership of POSTGRES_DB.
# - MUST match the user portion of DATABASE_URL in .env.
# -----------------------------------------------------------------------------
POSTGRES_USER=username

# -----------------------------------------------------------------------------
# Password for POSTGRES_USER.
# - MUST match the password portion of DATABASE_URL in .env.
# - Generate with: openssl rand -hex 16
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=password

# -----------------------------------------------------------------------------
# Database created on first boot, owned by POSTGRES_USER.
# - MUST match the database portion of DATABASE_URL in .env.
# -----------------------------------------------------------------------------
POSTGRES_DB=db_name
