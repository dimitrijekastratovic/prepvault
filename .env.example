# PrepVault environment variables
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored — never commit real secrets.

# --- Application ---

# JWT signing key. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# In Docker Compose this is overridden in docker-compose.yml.
# Set this when running the app outside Docker (e.g. seeding scripts, local tests).
DATABASE_URL=postgresql://user:password@localhost:5432/interview_prep

# --- Judge0 (Phase 5.6) ---
# Base URL of the Judge0 instance. Defaults to the in-compose service.
# JUDGE0_BASE_URL=http://judge0:2358
# JUDGE0_AUTH_TOKEN=
