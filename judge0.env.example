# =============================================================================
# judge0.env — config for Judge0's API and worker processes.
# Loaded into BOTH judge0-api and judge0-worker via `env_file: judge0.env` in
# docker-compose.yml. Read by Judge0's Rails app at boot.
#
# Full reference (upstream defaults):
#   https://github.com/judge0/judge0/blob/master/judge0.conf
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres connection for Judge0's internal database.
# All five values are required by Judge0's Rails app at boot.
# MUST match the corresponding values in judge0-db.env.
# -----------------------------------------------------------------------------
# Docker service name of Judge0's Postgres container (resolved via Docker DNS).
POSTGRES_HOST=judge0-db
# Port Postgres listens on inside its container (standard 5432).
POSTGRES_PORT=5432
# Database name; must match POSTGRES_DB in judge0-db.env.
POSTGRES_DB=db_name
# User Judge0 connects as; must match POSTGRES_USER in judge0-db.env.
POSTGRES_USER=username
# User's password; must match POSTGRES_PASSWORD in judge0-db.env.
POSTGRES_PASSWORD=password

# -----------------------------------------------------------------------------
# Redis connection used by Judge0 as a job queue (Resque).
# The judge0-api enqueues submissions; judge0-worker pops and runs them.
# -----------------------------------------------------------------------------
# Docker service name of the Redis container.
REDIS_HOST=judge0-redis
# Port Redis listens on (standard 6379).
REDIS_PORT=6379
# Password Judge0 sends on every Redis command.
# MUST match the password Compose passes to redis-server via --requirepass
# (compose reads this same file with $$REDIS_PASSWORD, so this is the single
# source of truth for the Redis password).
REDIS_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Auth — Judge0 rejects every request without a matching auth token.
# This is what prevents unauthenticated callers (or other containers on the
# judge0_net network) from submitting arbitrary code execution requests.
# -----------------------------------------------------------------------------
# HTTP header name Judge0 looks for. Standard value; do not change unless you
# also change the client (the app sends this exact header name).
AUTHN_HEADER=X-Auth-Token
# Shared secret. MUST match JUDGE0_AUTH_TOKEN in .env.
# Generate with: openssl rand -hex 32
AUTHN_TOKEN=changeme

# -----------------------------------------------------------------------------
# Per-submission execution limits enforced by isolate (the Linux sandbox).
# These are *defaults*; per-submission overrides may shrink (never expand)
# them via the API request body.
# -----------------------------------------------------------------------------
# CPU time in seconds before isolate kills the process (status: TLE).
CPU_TIME_LIMIT=5
# Grace period in seconds added before SIGKILL after CPU_TIME_LIMIT is hit.
CPU_EXTRA_TIME=1
# Wall-clock time in seconds (catches deadlocked/sleeping processes that don't
# burn CPU).
WALL_TIME_LIMIT=10
# Memory cap per submission in kilobytes (256000 KB = 250 MB).
MEMORY_LIMIT=256000
# Max number of processes/threads a submission can spawn (forkbomb defense).
MAX_PROCESSES_AND_OR_THREADS=60
# If true, applies CPU_TIME_LIMIT to each process/thread individually instead
# of the whole submission. Almost always false — the per-submission limit is
# what users reason about.
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
# Same idea for MEMORY_LIMIT. Almost always false.
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false

# -----------------------------------------------------------------------------
# Queue and worker tuning.
# -----------------------------------------------------------------------------
# Number of worker processes inside the judge0-worker container. More = higher
# concurrency but more CPU/memory consumed by Judge0 itself.
COUNT=2
# Max queued submissions before the API starts rejecting with 503. Prevents
# unbounded backlog growth if the workers can't keep up.
MAX_QUEUE_SIZE=100
