# =============================================================================
# .env — application config consumed by the FastAPI process.
# Loaded into the `app` container via `env_file: .env` in docker-compose.yml.
# =============================================================================

# -----------------------------------------------------------------------------
# Database connection string used by SQLModel / SQLAlchemy.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# - host MUST be `app-db` (the compose service name) when running via compose;
#   use `localhost` if running the app outside compose against a host-mapped DB.
# - user/password/database MUST match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB
#   in app-db.env (those values seed the Postgres container on first boot).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@app-db:5432/db_name

# -----------------------------------------------------------------------------
# Database connection string for tests. The app uses the same Postgres container
# for both normal and test databases, so the host/user/password are the same —
# only the database name differs. Like DATABASE_URL, this must match the
# credentials in app-db.env.
TEST_DATABASE_URL=postgresql://username:password@app-db:5432/test_db_name

# -----------------------------------------------------------------------------
# When "true", SQLAlchemy logs every emitted SQL statement to stdout.
# - Useful in local development for debugging queries and ORM behavior.
# - MUST be left unset (or "false") in production: logging every statement
#   hurts performance, balloons log volume, and risks leaking row data into
#   logs. Accepted values are case-insensitive; anything other than "true"
#   disables echo.
# -----------------------------------------------------------------------------
DATABASE_DEBUG=false

# -----------------------------------------------------------------------------
# Symmetric secret used to sign and verify JWT access tokens.
# - 32+ bytes of entropy. Generate with: openssl rand -hex 32
# - Rotating this key invalidates every active session — only do it
#   intentionally.
# - NEVER commit a real value to git; this file is the example.
# -----------------------------------------------------------------------------
SECRET_KEY=changeme

# -----------------------------------------------------------------------------
# Base URL the app uses to reach the Judge0 API.
# - In-compose: http://judge0-api:2358 (Docker DNS resolves the service name).
# - Outside compose: http://localhost:2358 (Judge0's published host port).
# -----------------------------------------------------------------------------
JUDGE0_URL=http://judge0-api:2358

# -----------------------------------------------------------------------------
# Shared secret the app sends in the X-Auth-Token header on every Judge0 call.
# - MUST match AUTHN_TOKEN in judge0.env, otherwise Judge0 rejects every request
#   with 401 Unauthorized.
# - Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
JUDGE0_AUTH_TOKEN=changeme
